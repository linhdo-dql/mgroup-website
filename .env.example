# ==============================================================================
# 1. PUBLIC CLIENT VARIABLES (Bundled into client JS — NEVER put secrets here)
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_ENABLE_MOCKS=true

# ==============================================================================
# 2. SERVER / ROUTE HANDLER VARIABLES (Server-side only)
# ==============================================================================
# Optional webhook URL (Google Apps Script / Slack / Telegram / CRM) for contact submissions
CONTACT_WEBHOOK_URL=
# Optional Resend API key for sending email notifications on contact submission
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
