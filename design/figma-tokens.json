{
  "$schema": "https://mgroup.vn/schemas/figma-tokens.json",
  "meta": {
    "source": "M.Group Handover Wireframe & Specification (Nov 2026)",
    "desktopFrameWidth": 1280,
    "contentWidth": 1200,
    "fontFamily": "Inter Variable"
  },
  "grid": {
    "mobile": {
      "width": 390,
      "columns": 4,
      "gutterPx": 16,
      "marginPx": 16
    },
    "tablet": {
      "width": 768,
      "columns": 8,
      "gutterPx": 20,
      "marginPx": 28
    },
    "desktop": {
      "width": 1280,
      "contentWidth": 1200,
      "columns": 12,
      "gutterPx": 24,
      "marginPx": 40
    }
  },
  "colors": {
    "primitive": {
      "neutral-0": "#FFFFFF",
      "neutral-50": "#FAFAFA",
      "neutral-100": "#F4F4F5",
      "neutral-200": "#E4E4E7",
      "neutral-300": "#D4D4D8",
      "neutral-400": "#A1A1AA",
      "neutral-500": "#71717A",
      "neutral-600": "#52525B",
      "neutral-700": "#3F3F46",
      "neutral-800": "#27272A",
      "neutral-900": "#18181B",
      "brand-primary": "#18181B",
      "brand-accent": "#1D4ED8",
      "brand-accent-light": "#DBEAFE",
      "semantic-success": "#15803D",
      "semantic-success-subtle": "#DCFCE7",
      "semantic-warning": "#B45309",
      "semantic-warning-subtle": "#FEF3C7",
      "semantic-danger": "#DC2626",
      "semantic-danger-subtle": "#FEE2E2"
    },
    "alias": {
      "light": {
        "text-primary": "#18181B",
        "text-secondary": "#3F3F46",
        "text-muted": "#52525B",
        "text-subtle": "#71717A",
        "text-inverse": "#FFFFFF",
        "text-accent": "#1D4ED8",
        "surface-default": "#FFFFFF",
        "surface-subtle": "#FAFAFA",
        "surface-muted": "#F4F4F5",
        "surface-elevated": "#FFFFFF",
        "surface-dark": "#18181B",
        "border-subtle": "#E4E4E7",
        "border-default": "#D4D4D8",
        "border-strong": "#A1A1AA",
        "border-accent": "#1D4ED8",
        "action-primary": "#18181B",
        "action-primary-hover": "#3F3F46",
        "action-accent": "#1D4ED8",
        "status-ready-bg": "#DCFCE7",
        "status-ready-text": "#15803D",
        "status-tuned-bg": "#DBEAFE",
        "status-tuned-text": "#1D4ED8",
        "status-danger": "#DC2626"
      },
      "dark": {
        "text-primary": "#FFFFFF",
        "text-secondary": "#D4D4D8",
        "text-muted": "#A1A1AA",
        "text-subtle": "#71717A",
        "text-inverse": "#18181B",
        "text-accent": "#60A5FA",
        "surface-default": "#18181B",
        "surface-subtle": "#27272A",
        "surface-muted": "#3F3F46",
        "surface-elevated": "#27272A",
        "surface-dark": "#09090B",
        "border-subtle": "#27272A",
        "border-default": "#3F3F46",
        "border-strong": "#52525B",
        "border-accent": "#60A5FA",
        "action-primary": "#FFFFFF",
        "action-primary-hover": "#E4E4E7",
        "action-accent": "#60A5FA",
        "status-ready-bg": "#14532D",
        "status-ready-text": "#86EFAC",
        "status-tuned-bg": "#1E3A8A",
        "status-tuned-text": "#93C5FD",
        "status-danger": "#F87171"
      }
    }
  },
  "typography": {
    "h1": {
      "desktopSizePx": 48,
      "lineHeightRatio": 1.15,
      "letterSpacingEm": -0.02,
      "fontWeight": 700
    },
    "h2": {
      "desktopSizePx": 34,
      "lineHeightRatio": 1.2,
      "letterSpacingEm": -0.01,
      "fontWeight": 700
    },
    "h3": {
      "desktopSizePx": 20,
      "lineHeightRatio": 1.35,
      "letterSpacingEm": -0.005,
      "fontWeight": 600
    },
    "h4": {
      "desktopSizePx": 17,
      "lineHeightRatio": 1.35,
      "letterSpacingEm": 0,
      "fontWeight": 600
    },
    "body-lg": {
      "desktopSizePx": 18,
      "lineHeightRatio": 1.6,
      "letterSpacingEm": 0,
      "fontWeight": 400
    },
    "body-md": {
      "desktopSizePx": 16,
      "lineHeightRatio": 1.6,
      "letterSpacingEm": 0,
      "fontWeight": 400
    },
    "body-sm": {
      "desktopSizePx": 15,
      "lineHeightRatio": 1.55,
      "letterSpacingEm": 0,
      "fontWeight": 400
    },
    "caption": {
      "desktopSizePx": 13,
      "lineHeightRatio": 1.5,
      "letterSpacingEm": 0,
      "fontWeight": 400
    },
    "overline": {
      "desktopSizePx": 12,
      "lineHeightRatio": 1.4,
      "letterSpacingEm": 0.06,
      "fontWeight": 600
    }
  },
  "radius": {
    "4": 4,
    "6": 6,
    "8": 8,
    "10": 10,
    "12": 12,
    "16": 16,
    "pill": 9999
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgb(24 24 27 / 4%)",
    "soft": "0 8px 24px -4px rgb(24 24 27 / 6%), 0 2px 6px -1px rgb(24 24 27 / 4%)",
    "medium": "0 16px 36px -6px rgb(24 24 27 / 10%), 0 4px 10px -2px rgb(24 24 27 / 5%)"
  }
}
